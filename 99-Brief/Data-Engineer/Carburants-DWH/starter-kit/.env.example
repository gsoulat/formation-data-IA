# Copiez ce fichier en .env et adaptez les valeurs.
# Le fichier .env ne doit JAMAIS etre commite (ajoutez-le a votre .gitignore).

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=rouleo
POSTGRES_PASSWORD=changeme
POSTGRES_DB=carburants
POSTGRES_PORT=5432

# --- Variables lues par psycopg2 (scripts Python) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=carburants
PGUSER=rouleo
PGPASSWORD=changeme

# --- SMTP de test (MailHog) ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAILHOG_UI_PORT=8025
ALERTE_DESTINATAIRE=cto@rouleo.example
ALERTE_EXPEDITEUR=etl@rouleo.example

# --- Perimetre de chargement ---
# Travaillez sur quelques departements pour iterer vite.
ANNEE_ARCHIVE=2025
DEPARTEMENTS=59,62
