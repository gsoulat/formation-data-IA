# Copier en .env à la racine du projet Astro. `astro dev start` le charge en local,
# `astro deployment variable create --load --env .env --secret` l'envoie sur Astro.
# Ne jamais versionner .env : il contient la clé privée.
#
# Un seul secret : la connexion Airflow `snowflake_nyc_taxi`, au format JSON.
#   - "private_key_content" = contenu de rsa_key.p8 sur UNE ligne, retours à la ligne écrits \n.
#     Génération :  awk 'NF {printf "%s\\n", $0}' ~/.ssh/snowflake/rsa_key.p8
#   - le provider Snowflake accepte aussi la clé encodée en base64 :  base64 -i rsa_key.p8 | tr -d '\n'
AIRFLOW_CONN_SNOWFLAKE_NYC_TAXI='{"conn_type":"snowflake","login":"AIRFLOW_SVC","extra":{"account":"ORGNAME-ACCOUNTNAME","warehouse":"NYC_TAXI_WH","database":"NYC_TAXI","role":"TRANSFORMER","private_key_content":"-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...REMPLACER...\n-----END PRIVATE KEY-----"}}'
