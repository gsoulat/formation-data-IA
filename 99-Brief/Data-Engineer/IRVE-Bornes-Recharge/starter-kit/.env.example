# Copiez ce fichier en .env et adaptez les valeurs.
# Le fichier .env ne doit JAMAIS etre commite (ajoutez-le a votre .gitignore).

POSTGRES_USER=voltiq
POSTGRES_PASSWORD=changeme
POSTGRES_DB=irve
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# User-Agent utilise pour le scraping et les appels API.
# Identifiez-vous honnetement : nom du projet + moyen de contact.
HTTP_USER_AGENT=voltiq-pipeline/1.0 (formation data engineer; contact@example.org)

# Temporisation minimale entre deux requetes sortantes, en secondes.
HTTP_MIN_DELAY=1.0
