# Copiez ce fichier en .env et adaptez les valeurs.
# Le fichier .env ne doit JAMAIS etre commite.

# --- Zone travaillee : PostgreSQL d'Eclairage ---
# Port 5433 et non 5432 : OpenMetadata embarque sa propre base sur 5432.
POSTGRES_USER=eclairage
POSTGRES_PASSWORD=changeme
POSTGRES_DB=transparence
POSTGRES_PORT=5433

# Variables lues par psql / psycopg depuis VOTRE machine.
PGHOST=localhost
PGPORT=5433
PGDATABASE=transparence
PGUSER=eclairage
PGPASSWORD=changeme

# ATTENTION : depuis OpenMetadata (qui tourne dans le reseau Docker), cette base
# n'est PAS sur localhost:5433 mais sur postgres_eclairage:5432.

# --- Zone brute : MinIO (stockage objet S3) ---
MINIO_ROOT_USER=eclairage
MINIO_ROOT_PASSWORD=changeme123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Endpoint S3 pour vos scripts Python (boto3), depuis votre machine :
S3_ENDPOINT_URL=http://localhost:9000

# ATTENTION : depuis OpenMetadata, l'endpoint est http://minio:9000.

# --- Roles applicatifs que vous creerez en Phase 4 ---
# Les mots de passe reels vont dans .env, jamais dans les scripts SQL versionnes.
ROLE_ANALYSTE_PASSWORD=changeme
ROLE_PRESSE_PASSWORD=changeme

# --- Collecte depuis l'API publique ---
HTTP_USER_AGENT=eclairage-pipeline/1.0 (formation data engineer; contact@example.org)
HTTP_MIN_DELAY=1.0

# --- OpenMetadata ---
# Interface : http://localhost:8585  (admin@open-metadata.org / admin)
# Airflow d'ingestion : http://localhost:8080
