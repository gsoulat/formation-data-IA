# Copiez ce fichier en .env et adaptez les valeurs.
# Le fichier .env ne doit JAMAIS etre commite (ajoutez-le a votre .gitignore).

# --- PostgreSQL ---
POSTGRES_USER=rebalance
POSTGRES_PASSWORD=changeme
POSTGRES_DB=velos
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# --- Kafka ---
# KAFKA_PORT est le port expose sur VOTRE machine. Si vous le changez, l'adresse
# annoncee par le broker suit automatiquement (voir docker-compose.yml).
KAFKA_PORT=9092

# Adresse utilisee par vos scripts Python, qui tournent sur votre machine :
# c'est le listener EXTERNAL. Depuis un conteneur, ce serait kafka:29092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=rebalance-ingestion

# Identifiant de cluster KRaft. Laissez tel quel sauf si vous savez pourquoi.
CLUSTER_ID=5L6g3nShT-eMCtK--X86sw

# --- Collecte ---
# Identifiez-vous honnetement aupres des services publics interroges.
HTTP_USER_AGENT=rebalance-collector/1.0 (formation data engineer; contact@example.org)

# Frequence de sondage, en secondes. A JUSTIFIER au regard du ttl annonce par le GBFS.
POLL_INTERVAL_SECONDS=60
HTTP_TIMEOUT_SECONDS=15
