# Copier ce fichier sous le nom .env, dans ce même dossier airflow/. `astro dev start` le lit au démarrage.
# Ne jamais versionner .env : il contient la clé privée.
#
# Une seule variable : la connexion Airflow `snowflake_nyc_taxi`, au format JSON.
#   - remplacer ORGANISATION-COMPTE, le login, le warehouse et le rôle par les vôtres ;
#   - "private_key_content" = le contenu de votre fichier rsa_key.p8 sur UNE seule ligne,
#     les retours à la ligne étant écrits \n. Pour l'obtenir :
#         awk 'NF {printf "%s\\n", $0}' ~/.ssh/snowflake/rsa_key.p8
AIRFLOW_CONN_SNOWFLAKE_NYC_TAXI='{"conn_type":"snowflake","login":"AIRFLOW_SVC","extra":{"account":"ORGANISATION-COMPTE","warehouse":"NYC_TAXI_WH","database":"NYC_TAXI","role":"TRANSFORMER","private_key_content":"-----BEGIN PRIVATE KEY-----\nMIIEv...REMPLACER...\n-----END PRIVATE KEY-----\n"}}'
