# Base de données — copiez ce fichier en .env et adaptez les valeurs.
# .env ne doit JAMAIS être versionné.
POSTGRES_USER=bouquineo
POSTGRES_PASSWORD=changez_moi
POSTGRES_DB=bouquineo
POSTGRES_PORT=5432

# API — secrets d'authentification.
# Générez une valeur aléatoire, ne réutilisez pas celle-ci.
API_SECRET_KEY=changez_moi_par_une_valeur_aleatoire
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Quota d'appel (valeurs de départ, à ajuster et à justifier)
RATE_LIMIT_ANONYME=30/minute
RATE_LIMIT_GESTIONNAIRE=120/minute
