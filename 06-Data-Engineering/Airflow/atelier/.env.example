# Copier en .env :  cp .env.example .env
# Le fichier .env n'est JAMAIS commité (il est dans .gitignore).

# Linux : mettre le résultat de `id -u`. macOS / Windows : laisser 50000.
AIRFLOW_UID=50000
AIRFLOW_PORT=8080

# Clé de chiffrement des mots de passe stockés par Airflow. Générer avec :
#   docker compose run --rm airflow-cli python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=changer-moi

# ---------------------------------------------------------------------------
# Connexion Snowflake (mercredi). Remplacer <COMPTE> par l'identifiant du
# compte, au format ORGANISATION-COMPTE (Snowsight > menu du compte > Account details).
# La clé privée est lue dans secrets/ ; elle n'est jamais écrite ici.
# ---------------------------------------------------------------------------
AIRFLOW_CONN_SNOWFLAKE_DEFAULT='{"conn_type": "snowflake", "login": "AIRFLOW_SVC", "schema": "RAW", "extra": {"account": "<COMPTE>", "warehouse": "WH_AIRFLOW", "database": "NYC_TAXI", "role": "ROLE_AIRFLOW", "private_key_file": "/opt/airflow/secrets/rsa_key.p8"}}'
